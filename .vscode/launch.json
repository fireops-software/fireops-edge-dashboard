    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Frontend",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5173/",
            "webRoot": "${workspaceFolder}/ui/fireops-dashboard"
        },
        {
            "name": "Run Frontend Webserver",
            "command": "npm install && npm run dev",
            "request": "launch",
            "type": "node-terminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}/ui/fireops-dashboard"
        },
        {
            "name": "Run Backend",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "env": {
                "RABBITMQ_HOST": "192.168.178.21",
                "RABBITMQ_PORT": "5672",
                "RABBITMQ_USER": "guest",
                "RABBITMQ_PW": "guest",
                "RABBITMQ_EXCHANGE": "ActiveAlerts",
                "FIREOPS_BASE_URL": "https://einsatz.bfk-perg.at",
                "FIREOPS_TOKEN": "pZzrbnOsfmG4ZPoB2J7GOvZefpGcIAYoZ07AqUgHe97ca551",
                "FIREDEP_NAME": "Freiwillige Feuerwehr Klam",
                "FIREDEP_ADDR": "Klam 59, 4352 Klam",
                "FIREDEP_LOGO_URL": "https://sybos.ooelfv.at/sybServices/getImage.php?typ=abteilung&id=1000",
                "API_PORT": "8080"
            },
        }
    ]
}
