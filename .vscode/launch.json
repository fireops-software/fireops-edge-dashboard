{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Frontend",
            "request": "launch",
            "type": "chrome",
            "runtimeArgs": ["--autoplay-policy=no-user-gesture-required"],
            "url": "http://localhost:5173/",
            "webRoot": "${workspaceFolder}/ui/fireops-dashboard"
        },
        {
            "name": "Run Frontend Webserver",
            "command": "npm install && npm run dev",
            "request": "launch",
            "type": "node-terminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}/ui/fireops-dashboard"
        },
        {
            "name": "Run Backend",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "env": {
                "RABBITMQ_HOST": "rabbitmq",
                "RABBITMQ_USER": "fireops",
                "RABBITMQ_PW": "fireops",

                "FIREDEP_NAME": "Freiwillige Feuerwehr Klam",
                "FIREDEP_ADDR": "Klam 59, 4352 Klam",
                "FIREDEP_LOGO_URL": "https://feuerwehr.klam.at/files/layout/FREIWILLIGE_FEUERWEHR_KLAM.png",
                "FIREDEP_MAX_TIME_TEXT_TO_SPEECH": "30",
                "FIREDEP_COUNT_TEXT_TO_SPEECH_DISPACHED": "1",
                "API_PORT": "8090",
                "SCREEN_BLANKING_DELAY": "10",
                "NIGHT_MODE_START": "21:30",
                "NIGHT_MODE_END": "10:00",
                "UI_THEME": "default"
            },
        }
    ]
}
