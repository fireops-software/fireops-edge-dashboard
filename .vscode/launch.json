{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Frontend",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5173/",
            "webRoot": "${workspaceFolder}/ui/fireops-dashboard"
        },
        {
            "name": "Run Frontend Webserver",
            "command": "npm install && npm run dev",
            "request": "launch",
            "type": "node-terminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}/ui/fireops-dashboard"
        },
        {
            "name": "Run Backend",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "env": {
                "RABBITMQ_HOST": "192.168.178.52",
                "RABBITMQ_PORT": "5672",
                "RABBITMQ_USER": "guest",
                "RABBITMQ_PW": "guest",
                "RABBITMQ_EXCHANGE": "",
                "FIREOPS_BASE_URL": "",
                "FIREOPS_TOKEN": "",
                "FIREDEP_NAME": "",
                "FIREDEP_ADDR": "",
                "FIREDEP_LOGO_URL": "",
                "API_PORT": "8080"
            },
        }
    ]
}
